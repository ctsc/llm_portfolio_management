# ARCTIC settings for the weekend scripts. Copy to scripts/arctic/arctic.env and fill in every
# TBD during PLAN2 phase 15 A and C (see docs/arctic_setup.md). The scripts refuse to run with a TBD.
# DECISION(W1): no job may request more than MAX_JOB_HOURS (15); aim for 12 or less.
# DECISION(M1): CPU jobs request --mem-per-cpu=3G and only the cores they use.
SLURM_ACCOUNT=TBD                 # sbatch --account
GPU_PARTITION=TBD                 # partition with GPUs for Kronos and the LLM fallback server
CPU_PARTITION=TBD                 # partition for the LLM, finish and shuffle jobs
GPU_GRES=TBD                      # e.g. gpu:1
GPU_MEM=TBD                       # host memory for GPU jobs, e.g. 32G (sbatch --mem)
KRONOS_WALLTIME=TBD               # e.g. 04:00:00 (J1 and J2 on a GPU node)
LLM_WALLTIME=TBD                  # e.g. 06:00:00 (J3 then J4, CPU, 2 cores)
FINISH_WALLTIME=03:00:00          # one J5 poll plus J6 to J9 (CPU, 1 core); resubmits itself
POLL_INTERVAL_MINUTES=60          # delay between finish-job resubmissions while API batches run
SHUFFLE_WALLTIME=TBD              # e.g. 02:00:00 per shard
MAX_JOB_HOURS=15                  # DECISION(W1) ceiling; common.sh refuses longer walltimes
PYTHON_MODULE=TBD                 # module load name, e.g. python/3.11
VENV_PATH=TBD                     # virtualenv with portstudy installed
DATA_ROOT=TBD                     # PORTSTUDY_DATA_DIR on the cluster file system
HF_HOME=TBD                       # Hugging Face cache with the fallback model weights downloaded
ARCTIC_NETWORK_MODE=TBD           # compute (nodes reach the internet) or login (only the login node)
SHUFFLE_MAX_PARALLEL=TBD          # array throttle, e.g. 50
LLM_FALLBACK_WALLTIME=TBD         # e.g. 10:00:00, how long the fallback server stays up
